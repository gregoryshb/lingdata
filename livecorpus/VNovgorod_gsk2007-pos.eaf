    <TIER ANNOTATOR="gregoryshb" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="Кузьмин Григорий" TIER_ID="text@gsk2007">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a311"
                TIME_SLOT_REF1="ts16" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>эээ ну /  наверно / с / тем чтобы привыкнуть к / быту / привыкнуть к / самостоятельной жизни</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a312"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>ну / наладить хорошие отношения с соседями  и с= / с одногруппниками</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a313"
                TIME_SLOT_REF1="ts52" TIME_SLOT_REF2="ts67">
                <ANNOTATION_VALUE>эээ / ну в остально= в остальном в принципе / жалоб особо нет</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a314"
                TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts103">
                <ANNOTATION_VALUE>ну / ну я конечно / не маменькин сынок </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315"
                TIME_SLOT_REF1="ts105" TIME_SLOT_REF2="ts121">
                <ANNOTATION_VALUE>не знаю / ну / подходят воще такие выражения #нрзб#</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316"
                TIME_SLOT_REF1="ts123" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>но / ну тяжело / я ну гото= я умею / э постоять за себя / так сказать / э в общем / жить / ну / одному</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317"
                TIME_SLOT_REF1="ts153" TIME_SLOT_REF2="ts173">
                <ANNOTATION_VALUE>но очень тяжело когда / э никто в твоеом общежитии / не заинтересован в ковортной жизни кроме тебя</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="gregoryshb" DEFAULT_LOCALE="ru"
