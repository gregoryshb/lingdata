    <TIER ANNOTATOR="gregoryshb" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="Кузьмин Григорий" TIER_ID="text@gsk2007.2">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a536"
                TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>эээ ну /  наверно / с / тем чтобы привыкнуть к / быту / привыкнуть к / самостоятельной жизни</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a537"
                TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts51">
                <ANNOTATION_VALUE> ну / наладить хорошие отношения с соседями и с= / с одногруппниками</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a538"
                TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>эээ / ну в остально= в остальном в принципе / жалоб особо нет</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a539"
                TIME_SLOT_REF1="ts93" TIME_SLOT_REF2="ts102">
                <ANNOTATION_VALUE>ну / ну я конечно / не маменькин сынок </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540"
                TIME_SLOT_REF1="ts104" TIME_SLOT_REF2="ts120">
                <ANNOTATION_VALUE>не знаю / ну / подходят воще такие выражения #нрзб#</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541"
                TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>но / ну тяжело / я ну гото= я умею / э постоять за себя / так сказать / э в общем / жить / ну / одному</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542"
                TIME_SLOT_REF1="ts154" TIME_SLOT_REF2="ts172">
                <ANNOTATION_VALUE>но очень тяжело когда / э никто в твоеом общежитии / не заинтересован в ковортной жизни кроме тебя</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
