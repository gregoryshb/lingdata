        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a315"
                TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts152">
                <ANNOTATION_VALUE>не знаю / ну / разбить подходят вообще такие выражения #нрзб#</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a316"
                TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts194">
                <ANNOTATION_VALUE>но / ну тяжело разбить/ я ну гото= я умею / э постоять за себя разбить/ так сказать / э в общем / жить / ну / одному</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a317"
                TIME_SLOT_REF1="ts195" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>но очень тяжело когда / э никто в твоеом общежитии /разбить не заинтересован в ковортной жизни кроме тебя</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
